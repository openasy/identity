{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy Identity API",
    "version": "0.1.0",
    "summary": "Single sign-on for OpenAsy products and any other application.",
    "description": "Every screen of Identity uses this API, and so can your scripts (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nThe OpenID provider is at `/.well-known/openid-configuration` and `/oidc/*` (ADR 0033); applications sign people in there. Identity providers provision people and groups with SCIM 2.0 at `/scim/v2`, with the token from `/api/v1/provisioning`. The operations below take the session of a signed-in person or an API token, and each names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This Identity"
    }
  ],
  "tags": [
    {
      "name": "Applications",
      "description": "Applications people sign in to with OpenID Connect, and who may use each."
    },
    {
      "name": "Directory",
      "description": "People and groups."
    },
    {
      "name": "Product",
      "description": "Version and health of this VPN."
    }
  ],
  "paths": {
