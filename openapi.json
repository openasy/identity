  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when Identity runs on plain http://localhost). Requests that change something must come from the Identity origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings → API tokens (`oa_identity_...`): one role, always an expiry (ADR 0003)."
      }
    },
    "responses": {
      "Problem": {
        "description": "The request was refused. `code` is stable; `detail` says what to do.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "identity"
          },
          "version": {
            "type": "string",
            "description": "SemVer of this release.",
            "examples": [
              "0.1.0"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "examples": [
              "https://openasy.github.io/problems/version-mismatch"
            ]
          },
          "title": {
            "type": "string",
            "examples": [
              "Version mismatch"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "examples": [
              "vpn-server 0.0.9 does not match vpn 0.1.0; install vpn-server 0.1.0"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable identifier to match on in code.",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "version-mismatch",
              "not-found",
              "conflict",
              "not-configured",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ]
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "examples": [
              "ok",
              "ready"
            ]
          }
        }
      },
      "Application": {
        "type": "object",
        "required": [
          "id",
          "name",
          "template",
          "redirectUris",
          "postLogoutRedirectUris",
          "everyone",
          "groups",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The client ID."
          },
          "name": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": [
              "openasy-vpn",
              "openasy-infrastructure",
              "openasy-vulnerabilities",
              "oidc"
            ]
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "postLogoutRedirectUris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "everyone": {
            "type": "boolean",
            "description": "Everyone in the directory may sign in; otherwise members of its groups."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApplicationList": {
        "type": "object",
        "required": [
          "applications",
          "issuer"
        ],
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "issuer": {
            "type": "string",
            "description": "The issuer applications are set up with."
          }
        }
      },
      "ApplicationSecret": {
        "type": "object",
        "required": [
          "application",
          "clientSecret"
        ],
        "properties": {
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "clientSecret": {
            "type": "string",
            "description": "Shown once; Identity keeps it sealed."
          }
        }
      },
      "NewApplication": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": [
              "openasy-vpn",
              "openasy-infrastructure",
              "openasy-vulnerabilities",
              "oidc"
            ],
            "default": "oidc"
          },
          "url": {
            "type": "string",
            "description": "For an OpenAsy product: the address people open it at. Its callback is filled in."
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For other applications: https, or http on localhost."
          },
          "postLogoutRedirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "everyone": {
            "type": "boolean"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApplicationChange": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "For an OpenAsy product: the address people open it at. Its callback is filled in."
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For other applications: https, or http on localhost."
          },
          "postLogoutRedirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "everyone": {
            "type": "boolean"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "syncedFrom",
          "mfa",
          "members",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "syncedFrom": {
            "type": [
              "string",
              "null"
            ],
            "description": "\"<provider>:<group>\": members come from that provider's group at each sign-in."
          },
          "members": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "mfa": {
            "type": "string",
            "enum": [
              "optional",
              "required",
              "passkey"
            ],
            "description": "required: members sign in to applications with a second factor, a passkey or an identity provider. passkey: only with a passkey."
          }
        }
      },
      "GroupList": {
        "type": "object",
        "required": [
          "groups"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Group"
            }
          }
        }
      },
      "NewGroup": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "syncedFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "mfa": {
            "type": "string",
            "enum": [
              "optional",
              "required",
              "passkey"
            ],
            "description": "required: members sign in to applications with a second factor, a passkey or an identity provider. passkey: only with a passkey."
          }
        }
      },
      "GroupChange": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "syncedFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "mfa": {
            "type": "string",
            "enum": [
              "optional",
              "required",
              "passkey"
            ],
            "description": "required: members sign in to applications with a second factor, a passkey or an identity provider. passkey: only with a passkey."
          }
        }
      },
      "GroupMembers": {
        "type": "object",
        "required": [
          "userIds"
        ],
        "properties": {
          "userIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "status",
          "groups",
          "secondFactor",
          "providers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "user for people who only sign in to applications; viewer and up also manage Identity."
          },
          "status": {
            "type": "string",
            "enum": [
              "invited",
              "active",
              "disabled"
            ]
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secondFactor": {
            "type": "boolean",
            "description": "Has an authenticator app or a passkey."
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Identity providers they sign in through."
          }
        }
      },
      "PersonList": {
        "type": "object",
        "required": [
          "people"
        ],
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Person"
            }
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": [
          "id",
          "at",
          "type",
          "actorName",
          "applicationName"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "description": "app-sign-in, app-sign-in-refused, sign-in, sign-in-failed, application-added, group-members-changed, member-invited and the other events of @openasy/auth.",
            "examples": [
              "app-sign-in"
            ]
          },
          "actor": {
            "type": "string"
          },
          "actorName": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "string"
          },
          "application": {
            "type": "string"
          },
          "applicationName": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "AuditList": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          }
        }
      },
      "Overview": {
        "type": "object",
        "required": [
          "people",
          "applications",
          "groups",
          "appSignIns24h",
          "refused24h",
          "failedSignIns24h",
          "withoutSecondFactor"
        ],
        "properties": {
          "people": {
            "type": "integer"
          },
          "applications": {
            "type": "integer"
          },
          "groups": {
            "type": "integer"
          },
          "appSignIns24h": {
            "type": "integer",
            "description": "Sign-ins to applications in the last 24 hours, counted when the application exchanged its code."
          },
          "refused24h": {
            "type": "integer",
            "description": "Sign-ins to applications refused in the last 24 hours."
          },
          "failedSignIns24h": {
            "type": "integer",
            "description": "Failed sign-ins to Identity in the last 24 hours."
          },
          "withoutSecondFactor": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "email"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                }
              }
            },
            "description": "Active people who sign in with a password alone."
          }
        }
      },
      "Provisioning": {
        "type": "object",
        "required": [
          "url",
          "tokenCreatedAt",
          "lastUsedAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "The SCIM 2.0 base URL to give the identity provider."
          },
          "tokenCreatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "null: no token, so SCIM is off."
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "token": {
            "type": "string",
            "description": "Only when made: the bearer token for the provider, shown once."
          }
        }
      }
    }
  }
}
